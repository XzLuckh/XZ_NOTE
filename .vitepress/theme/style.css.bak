@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');
:root {
  --vp-c-brand-1: #7c6cff;
  --vp-c-brand-2: #988dff;
  --vp-c-brand-3: #6558e8;
  --vp-c-bg: #0e111b;
  --vp-c-bg-soft: #141827;
  --vp-c-bg-alt: #0b0e16;
  --vp-c-text-1: #f4f5fb;
  --vp-c-text-2: #a6acc1;
  --vp-c-divider: rgba(174, 183, 217, .13);
  --vp-font-family-base: Inter, "PingFang SC", "Microsoft YaHei", sans-serif;
  --vp-font-family-mono: "SFMono-Regular", Consolas, monospace;
}
:root:not(.dark) {
  --vp-c-brand-1: #5c4fe0;
  --vp-c-brand-2: #6e62ed;
  --vp-c-brand-3: #493cc7;
  --vp-c-bg: #f7f8fc;
  --vp-c-bg-soft: #ffffff;
  --vp-c-bg-alt: #eef0f7;
  --vp-c-text-1: #20243a;
  --vp-c-text-2: #687088;
  --vp-c-divider: rgba(62, 72, 112, .14);
}

body { background: radial-gradient(circle at 70% 0%, rgba(86, 73, 190, .14), transparent 32rem), var(--vp-c-bg); }
:root:not(.dark) body { background: radial-gradient(circle at 72% 0%, rgba(124,108,255,.12), transparent 34rem), var(--vp-c-bg); }

/* 文档表格统一风格：适合操作手册和命令说明 */
.vp-doc table,
.VPDoc table,
.theme table,
.content table {
  display: table !important;
  width: 100% !important;
  table-layout: fixed !important;
  border-collapse: collapse !important;
  margin: 20px 0 !important;
  border: 2px solid rgba(173, 185, 214, .42) !important;
  border-radius: 12px !important;
  overflow: hidden !important;
  background: rgba(12, 17, 28, .9) !important;
}
.vp-doc thead th,
.VPDoc thead th,
.theme thead th,
.content thead th {
  padding: 16px 14px !important;
  color: #eef3ff !important;
  background: rgba(20, 27, 42, .96) !important;
  border: 2px solid rgba(173, 185, 214, .38) !important;
  font-weight: 700 !important;
  text-align: center !important;
}
.vp-doc tbody td,
.VPDoc tbody td,
.theme tbody td,
.content tbody td {
  padding: 16px 14px !important;
  color: #dfe6ff !important;
  background: rgba(13, 17, 27, .8) !important;
  border: 2px solid rgba(173, 185, 214, .38) !important;
  vertical-align: middle !important;
  line-height: 1.7 !important;
  text-align: center !important;
}
.vp-doc tbody tr:nth-child(even) td,
.VPDoc tbody tr:nth-child(even) td,
.theme tbody tr:nth-child(even) td,
.content tbody tr:nth-child(even) td {
  background: rgba(18, 23, 34, .8) !important;
}
.vp-doc tbody td:first-child,
.vp-doc thead th:first-child,
.VPDoc tbody td:first-child,
.VPDoc thead th:first-child,
.theme tbody td:first-child,
.theme thead th:first-child,
.content tbody td:first-child,
.content thead th:first-child { width: 72px !important; }
.vp-doc tbody td:nth-child(2),
.vp-doc thead th:nth-child(2),
.VPDoc tbody td:nth-child(2),
.VPDoc thead th:nth-child(2),
.theme tbody td:nth-child(2),
.theme thead th:nth-child(2),
.content tbody td:nth-child(2),
.content thead th:nth-child(2) { width: 140px !important; }
.vp-doc tbody td:nth-child(3),
.vp-doc thead th:nth-child(3),
.VPDoc tbody td:nth-child(3),
.VPDoc thead th:nth-child(3),
.theme tbody td:nth-child(3),
.theme thead th:nth-child(3),
.content tbody td:nth-child(3),
.content thead th:nth-child(3) { width: 36% !important; }
.vp-doc tbody td:nth-child(4),
.vp-doc thead th:nth-child(4),
.VPDoc tbody td:nth-child(4),
.VPDoc thead th:nth-child(4),
.theme tbody td:nth-child(4),
.theme thead th:nth-child(4),
.content tbody td:nth-child(4),
.content thead th:nth-child(4) { width: 26% !important; }
.vp-doc td code,
.VPDoc td code,
.theme td code,
.content td code {
  display: inline-block !important;
  max-width: 100% !important;
  padding: 5px 10px !important;
  border-radius: 8px !important;
  background: rgba(99, 117, 255, .18) !important;
  color: #9dd4ff !important;
  border: 1px solid rgba(99, 117, 255, .28) !important;
  font-family: var(--vp-font-family-mono) !important;
  white-space: normal !important;
  word-break: break-word !important;
}
:root:not(.dark) .vp-doc table,
:root:not(.dark) .VPDoc table,
:root:not(.dark) .theme table,
:root:not(.dark) .content table {
  background: rgba(255, 255, 255, .88) !important;
  border-color: rgba(96, 110, 170, .18) !important;
}
:root:not(.dark) .vp-doc thead th,
:root:not(.dark) .VPDoc thead th,
:root:not(.dark) .theme thead th,
:root:not(.dark) .content thead th {
  background: rgba(245, 247, 255, .96) !important;
  color: #1d2439 !important;
}
:root:not(.dark) .vp-doc tbody td,
:root:not(.dark) .VPDoc tbody td,
:root:not(.dark) .theme tbody td,
:root:not(.dark) .content tbody td {
  background: rgba(249, 250, 255, .82) !important;
  color: #28314d !important;
}
:root:not(.dark) .vp-doc tbody tr:nth-child(even) td,
:root:not(.dark) .VPDoc tbody tr:nth-child(even) td,
:root:not(.dark) .theme tbody tr:nth-child(even) td,
:root:not(.dark) .content tbody tr:nth-child(even) td {
  background: rgba(242, 245, 255, .9) !important;
}
:root:not(.dark) .vp-doc td code,
:root:not(.dark) .VPDoc td code,
:root:not(.dark) .theme td code,
:root:not(.dark) .content td code {
  background: rgba(92, 79, 224, .08) !important;
  color: #3a47b7 !important;
  border-color: rgba(92, 79, 224, .2) !important;
}
.VPHomeHero { position: relative; overflow: hidden; }
.VPHomeHero::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .26; background-image: linear-gradient(rgba(124,108,255,.12) 1px, transparent 1px), linear-gradient(90deg, rgba(39,199,184,.09) 1px, transparent 1px); background-size: 58px 58px; mask-image: linear-gradient(to bottom, #000, transparent 82%); animation: grid-drift 18s linear infinite; }
.VPHomeHero::after { content: ''; position: absolute; top: 20%; right: 8%; width: 180px; height: 180px; border-radius: 50%; background: #6756ff; filter: blur(90px); opacity: .13; pointer-events: none; animation: ambient-pulse 7s ease-in-out infinite; }
.VPNav { background: rgba(14, 17, 27, .76) !important; backdrop-filter: blur(16px); border-bottom-color: transparent !important; }
:root:not(.dark) .VPNav { background: rgba(247,248,252,.78) !important; }
.VPNavBarTitle .title { font-weight: 800; letter-spacing: .08em; }
.VPNavBarTitle .logo { width: 28px; height: 28px; }
.VPHero { padding-bottom: 48px !important; }
.VPHero .name { max-width: 760px; font-size: clamp(2.9rem, 7vw, 5.8rem); line-height: 1.08; letter-spacing: -.055em; }
.VPHero .text { max-width: 780px; font-size: clamp(1.45rem, 3vw, 2.5rem); font-weight: 650; line-height: 1.25; }
.VPHero .tagline { color: var(--vp-c-text-2); font-size: 1.1rem; }
.VPHero .image { position: relative; z-index: 1; animation: avatar-float 5s ease-in-out infinite; filter: drop-shadow(0 22px 30px rgba(8, 10, 23, .42)); }
.VPHero .image-container { display: grid; place-items: center; width: min(31vw, 340px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 20% 18%, rgba(255,255,255,.8) 0 1px, transparent 2px), radial-gradient(circle at 84% 27%, rgba(39,199,184,.95) 0 1.5px, transparent 3px), radial-gradient(circle at 8% 72%, rgba(124,108,255,.9) 0 1.5px, transparent 3px), radial-gradient(circle at 92% 80%, rgba(255,255,255,.65) 0 1px, transparent 2px), radial-gradient(circle, rgba(124,108,255,.15), transparent 67%); background-position: 0 0, 0 0, 0 0, 0 0, center; animation: particle-drift 8s ease-in-out infinite; }
.VPHero .image-src { position: relative; z-index: 2; width: min(25vw, 282px); aspect-ratio: 1; object-fit: cover; object-position: 50% 38%; border: 8px solid rgba(255,255,255,.09); border-radius: 50%; background: #171c3c; box-shadow: 0 0 0 1px rgba(255,255,255,.16), 0 0 0 9px rgba(124,108,255,.11), 0 18px 48px rgba(5,7,20,.62), inset 0 0 22px rgba(255,255,255,.12); }
.VPHero .image-bg { background-image: linear-gradient(135deg, rgba(124,108,255,.48), rgba(39,199,184,.32)); filter: blur(52px); opacity: .72; animation: avatar-glow 6s ease-in-out infinite alternate; }
.VPHero .image-container::before, .VPHero .image-container::after { content: ''; position: absolute; border-radius: 50%; pointer-events: none; }
.VPHero .image-container::before { width: 92%; height: 92%; padding: 2px; background: conic-gradient(from 30deg, transparent 0 24%, #7c6cff 35%, #27c7b8 47%, transparent 58% 78%, #7c6cff 88%, transparent); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; animation: orbit-spin 16s linear infinite; }
.VPHero .image-container::after { width: 112%; height: 112%; border: 1px solid rgba(39,199,184,.2); border-left-color: transparent; border-bottom-color: rgba(124,108,255,.35); box-shadow: 0 0 18px rgba(39,199,184,.14), inset 0 0 18px rgba(124,108,255,.08); animation: orbit-spin 24s linear infinite reverse; }
@keyframes avatar-float { 0%, 100% { transform: translateY(0) rotate(-1deg); } 50% { transform: translateY(-9px) rotate(1deg); } }
@keyframes avatar-glow { from { transform: scale(.92); opacity: .55; } to { transform: scale(1.08); opacity: .86; } }
@keyframes orbit-spin { to { transform: rotate(360deg); } }
@keyframes grid-drift { from { background-position: 0 0; } to { background-position: 58px 58px; } }
@keyframes particle-drift { 0%, 100% { background-position: 0 0, 0 0, 0 0, 0 0, center; } 50% { background-position: 7px -11px, -10px 8px, 11px 5px, -6px -9px, center; } }
@keyframes ambient-pulse { 0%, 100% { transform: scale(.8); opacity: .08; } 50% { transform: scale(1.2); opacity: .2; } }
.VPButton { border-radius: 10px !important; font-weight: 700; transition: transform .2s, box-shadow .2s; }
.VPButton:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(124,108,255,.24); }
.VPFeature { border: 1px solid var(--vp-c-divider) !important; border-radius: 16px !important; background: linear-gradient(145deg, rgba(24,28,45,.9), rgba(17,20,32,.72)) !important; transition: transform .25s, border-color .25s; }
.VPFeature:hover { transform: translateY(-4px); border-color: rgba(124,108,255,.55) !important; }
.VPFeature .icon { background: transparent; font-size: 1.55rem; }
.VPFeature .title { font-size: 1.08rem; }
.VPFeature .details { color: var(--vp-c-text-2); line-height: 1.75; }
.home-dashboard { max-width: 1152px; margin: 8px auto 80px; padding: 0 24px; }
.dashboard-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin: 46px 0 22px; }
.eyebrow, .topic-kicker { color: #9189ff; font-family: var(--vp-font-family-mono); font-size: .68rem; letter-spacing: .13em; }
.dashboard-heading h2 { margin: 9px 0 0; font-size: 1.55rem; letter-spacing: -.025em; }
.status-dot { color: var(--vp-c-text-2); font-size: .82rem; white-space: nowrap; }
.status-dot i { display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: #42d6a5; box-shadow: 0 0 12px #42d6a5; }
.topic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.topic-card { display: flex; flex-direction: column; min-height: 250px; padding: 24px; border: 1px solid var(--vp-c-divider); border-radius: 17px; color: inherit; background: rgba(20,24,39,.72); text-decoration: none; transition: transform .25s, border-color .25s, background .25s; }
.topic-card:hover { transform: translateY(-5px); border-color: rgba(124,108,255,.66); background: rgba(29,32,55,.9); }
.topic-card--accent { background: linear-gradient(150deg, rgba(75,65,174,.42), rgba(20,24,39,.76) 65%); }
.topic-icon { color: #b5afff; font-family: var(--vp-font-family-mono); font-size: 1.65rem; }
.topic-card__body { display: flex; flex: 1; flex-direction: column; }
.topic-kicker { margin-top: 27px; }
.topic-card h3 { margin: 8px 0 8px; font-size: 1.22rem; }
.topic-card p { margin: 0; color: var(--vp-c-text-2); font-size: .9rem; line-height: 1.7; }
.topic-link { margin-top: auto; padding-top: 22px; color: #b6b0ff; font-size: .85rem; font-weight: 650; }
.topic-link b { padding-left: 4px; transition: padding .2s; }
.topic-card:hover .topic-link b { padding-left: 10px; }
.terminal-note { display: flex; align-items: center; gap: 18px; margin-top: 18px; padding: 13px 17px; border: 1px solid var(--vp-c-divider); border-radius: 11px; background: rgba(8, 10, 17, .55); color: #8992ad; font-size: .78rem; }
.terminal-dots { display: flex; gap: 5px; }
.terminal-dots i { width: 7px; height: 7px; border-radius: 50%; background: #ef6b82; }
.terminal-dots i:nth-child(2) { background: #e7bd67; }.terminal-dots i:nth-child(3) { background: #42d6a5; }
.terminal-note em { color: #7c6cff; font-style: normal; }
:root:not(.dark) .VPFeature { background: linear-gradient(145deg, rgba(255,255,255,.96), rgba(241,243,250,.9)) !important; }
:root:not(.dark) .VPFeature:hover { border-color: rgba(92,79,224,.46) !important; }
:root:not(.dark) .topic-card { background: rgba(255,255,255,.78); box-shadow: 0 12px 30px rgba(43,50,91,.06); }
:root:not(.dark) .topic-card:hover { background: rgba(255,255,255,.98); border-color: rgba(92,79,224,.46); }
:root:not(.dark) .topic-card--accent { background: linear-gradient(150deg, rgba(224,221,255,.86), rgba(255,255,255,.9) 68%); }
:root:not(.dark) .terminal-note { background: rgba(255,255,255,.72); color: #6c7590; }
:root:not(.dark) .VPHero .image-bg { opacity: .34; }
:root:not(.dark) .VPHomeHero::after { opacity: .08; }
:root:not(.dark) .VPHero .image-src { box-shadow: 0 0 0 1px rgba(92,79,224,.44), 0 0 0 8px rgba(92,79,224,.08), 0 24px 55px rgba(43,50,91,.18); }
@media (max-width: 720px) { .VPHero { padding-top: 52px !important; }.VPHero .image-container { width: 260px; }.VPHero .image-src { width: 210px; }.VPHero .image-container::before, .VPHero .image-container::after { display: none; }.topic-grid { grid-template-columns: 1fr; }.dashboard-heading { align-items: start; flex-direction: column; }.terminal-note { overflow: auto; white-space: nowrap; } }
@media (prefers-reduced-motion: reduce) { .VPHomeHero::before, .VPHomeHero::after, .VPHero .image, .VPHero .image-bg, .VPHero .image-container, .VPHero .image-container::before, .VPHero .image-container::after { animation: none; } }

/* Refined avatar treatment: one focus point, fewer decorative layers. */
.VPHomeHero::before { display: none; }
.VPHomeHero::after { top: 8%; right: 13%; width: 240px; height: 240px; background: #5d6dff; filter: blur(110px); opacity: .16; }
.VPHero .image-container { width: min(31vw, 328px); background: radial-gradient(circle, rgba(72, 96, 190, .2), transparent 66%); animation: avatar-float 5s ease-in-out infinite; }
.VPHero .image-src { width: min(25vw, 272px); border: 5px solid rgba(255,255,255,.12); box-shadow: 0 0 0 1px rgba(124,108,255,.55), 0 0 0 8px rgba(124,108,255,.08), 0 24px 55px rgba(4,7,21,.58); }
.VPHero .image-container::before { width: 106%; height: 106%; padding: 0; background: none; border: 1px solid rgba(125,116,255,.52); box-shadow: 0 0 18px rgba(125,116,255,.18); -webkit-mask: none; mask: none; animation: ring-breathe 5s ease-in-out infinite; }
.VPHero .image-container::after { width: 7px; height: 7px; top: 14%; right: 14%; border: 0; background: #72e0d0; box-shadow: 0 0 0 5px rgba(114,224,208,.1), 0 0 18px rgba(114,224,208,.9); animation: dot-breathe 3s ease-in-out infinite; }
@keyframes ring-breathe { 0%, 100% { transform: scale(.98); opacity: .55; } 50% { transform: scale(1.02); opacity: .95; } }
@keyframes dot-breathe { 0%, 100% { transform: scale(.7); opacity: .55; } 50% { transform: scale(1.15); opacity: 1; } }
.docs-password-wrap {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background:
    radial-gradient(circle at 15% 20%, rgba(124,108,255,.28), transparent 25%),
    radial-gradient(circle at 85% 10%, rgba(92,200,255,.18), transparent 30%),
    linear-gradient(135deg, #0c1322 0%, #111827 100%);
}
.docs-password-panel {
  width: min(500px, 92vw);
  padding: 34px 30px 28px;
  border-radius: 22px;
  border: 1px solid rgba(160, 173, 219, .22);
  background: rgba(17, 22, 35, .88);
  box-shadow: 0 25px 80px rgba(4,7,18,.45), inset 0 1px 0 rgba(255,255,255,.04);
  backdrop-filter: blur(10px);
  text-align: center;
}
.docs-password-badge {
  display: inline-block;
  margin-bottom: 16px;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid rgba(124,108,255,.42);
  background: rgba(124,108,255,.12);
  color: #d8d2ff;
  font-size: .72rem;
  letter-spacing: .14em;
  text-transform: uppercase;
}
.docs-password-title {
  margin-bottom: 8px;
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  font-weight: 800;
  color: #f5f7ff;
}
.docs-password-subtitle {
  margin: 0 0 24px;
  color: #aeb9d9;
  font-size: 1rem;
}
.docs-password-input-wrap {
  position: relative;
}
.docs-password-panel input[type="password"] {
  width: 100%;
  box-sizing: border-box;
  padding: 14px 16px;
  border-radius: 12px;
  border: 1px solid rgba(160, 173, 219, .2);
  background: rgba(8, 12, 18, .9);
  color: #f4f7ff;
  font-size: 1rem;
  outline: none;
  transition: border-color .2s ease, box-shadow .2s ease;
}
.docs-password-panel input[type="password"]:focus {
  border-color: rgba(124,108,255,.8);
  box-shadow: 0 0 0 4px rgba(124,108,255,.12);
}
.docs-password-panel button {
  width: 100%;
  padding: 13px 18px;
  border: none;
  border-radius: 12px;
  background: linear-gradient(135deg, #7c6cff, #5cc8ff);
  box-shadow: 0 12px 24px rgba(124,108,255,.28);
  color: white;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform .2s ease, box-shadow .2s ease;
}
.docs-password-panel button:hover {
  transform: translateY(-1px);
  box-shadow: 0 16px 28px rgba(124,108,255,.36);
}
.docs-password-error {
  margin-top: 16px !important;
  color: #ff8da1 !important;
  font-size: .95rem;
}
@media (max-width: 720px) { .VPHero .image-container { width: 260px; }.VPHero .image-src { width: 210px; } }

/* =========================================================
   SLAM 板块与文档内容美化
   ========================================================= */

/* ---- 页首 Hero ---- */
.slam-hero {
  position: relative;
  margin: 2px 0 28px;
  padding: 32px 34px 28px;
  border: 1px solid rgba(124, 108, 255, .28);
  border-radius: 20px;
  background:
    radial-gradient(circle at 88% 10%, rgba(92, 200, 255, .14), transparent 44%),
    radial-gradient(circle at 4% 92%, rgba(124, 108, 255, .16), transparent 48%),
    linear-gradient(150deg, rgba(24, 28, 45, .92), rgba(17, 20, 32, .74));
  overflow: hidden;
}
.slam-hero::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image: linear-gradient(rgba(124, 108, 255, .07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(39, 199, 184, .05) 1px, transparent 1px);
  background-size: 46px 46px;
  -webkit-mask-image: linear-gradient(to bottom, #000, transparent 88%);
  mask-image: linear-gradient(to bottom, #000, transparent 88%);
}
.slam-eyebrow {
  position: relative;
  z-index: 1;
  margin: 0 0 10px;
  color: #9189ff;
  font-family: var(--vp-font-family-mono);
  font-size: .7rem;
  letter-spacing: .18em;
}
.slam-hero h1 {
  position: relative;
  z-index: 1;
  margin: 0;
  font-size: clamp(1.9rem, 4vw, 2.7rem);
  line-height: 1.15;
  letter-spacing: -.03em;
  background: linear-gradient(92deg, #f2f1ff 10%, #b9b2ff 48%, #7ce4ff 92%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.slam-lead {
  position: relative;
  z-index: 1;
  max-width: 680px;
  margin: 12px 0 0;
  color: var(--vp-c-text-2);
  font-size: 1rem;
  line-height: 1.8;
}
:root:not(.dark) .slam-hero {
  border-color: rgba(92, 79, 224, .24);
  background:
    radial-gradient(circle at 88% 10%, rgba(92, 200, 255, .12), transparent 44%),
    radial-gradient(circle at 4% 92%, rgba(124, 108, 255, .1), transparent 48%),
    linear-gradient(150deg, rgba(255, 255, 255, .98), rgba(241, 243, 250, .92));
}
:root:not(.dark) .slam-hero h1 {
  background: linear-gradient(92deg, #23204d 10%, #5c4fe0 55%, #0e7f96 95%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ---- 三大板块卡片 ---- */
.slam-board {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 22px 0 36px;
}
.slam-card {
  display: flex;
  flex-direction: column;
  min-height: 172px;
  padding: 22px 22px 18px;
  border: 1px solid var(--vp-c-divider);
  border-radius: 16px;
  background: linear-gradient(150deg, rgba(24, 28, 45, .9), rgba(17, 20, 32, .72));
  transition: transform .25s, border-color .25s, box-shadow .25s;
}
.slam-card:hover {
  transform: translateY(-4px);
  border-color: rgba(124, 108, 255, .6);
  box-shadow: 0 14px 34px rgba(5, 7, 20, .4);
}
.slam-card h3 { margin: 0 0 8px; font-size: 1.14rem; }
.slam-card p { margin: 0 0 16px; color: var(--vp-c-text-2); font-size: .88rem; line-height: 1.75; }
.slam-card .more-link {
  margin-top: auto;
  color: #b6b0ff;
  font-size: .85rem;
  font-weight: 650;
  text-decoration: none;
}
.slam-card .more-link b { padding-left: 4px; transition: padding .2s; }
.slam-card:hover .more-link b { padding-left: 9px; }
:root:not(.dark) .slam-card {
  background: linear-gradient(150deg, rgba(255, 255, 255, .98), rgba(241, 243, 250, .92));
  box-shadow: 0 10px 26px rgba(43, 50, 91, .06);
}
:root:not(.dark) .slam-card:hover { box-shadow: 0 16px 34px rgba(43, 50, 91, .12); }
:root:not(.dark) .slam-card .more-link { color: #5c4fe0; }

/* ---- 状态徽章 ---- */
.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 11px;
  border-radius: 999px;
  font-size: .74rem;
  font-weight: 650;
  letter-spacing: .02em;
  white-space: nowrap;
}
.status-pill::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.status--wip { color: #e7bd67; background: rgba(231, 189, 103, .12); border: 1px solid rgba(231, 189, 103, .32); }
.status--done { color: #42d6a5; background: rgba(66, 214, 165, .1); border: 1px solid rgba(66, 214, 165, .3); }
.status--plan { color: #a6acc1; background: rgba(166, 172, 193, .1); border: 1px solid rgba(166, 172, 193, .26); }
:root:not(.dark) .status--wip { color: #9a6a00; background: rgba(231, 189, 103, .16); border-color: rgba(231, 189, 103, .4); }
:root:not(.dark) .status--done { color: #0d8a5f; background: rgba(66, 214, 165, .16); border-color: rgba(66, 214, 165, .4); }

/* ---- 标签 chips ---- */
.tag-chip {
  display: inline-block;
  margin: 0 6px 6px 0;
  padding: 3px 10px;
  border-radius: 8px;
  border: 1px solid rgba(124, 108, 255, .32);
  background: rgba(124, 108, 255, .1);
  color: #b9b2ff;
  font-size: .76rem;
  font-family: var(--vp-font-family-mono);
}
:root:not(.dark) .tag-chip { color: #5c4fe0; background: rgba(92, 79, 224, .07); border-color: rgba(92, 79, 224, .24); }

/* ---- 项目卡片列表 ---- */
.project-card {
  margin: 14px 0 22px;
  padding: 20px 22px;
  border: 1px solid var(--vp-c-divider);
  border-radius: 16px;
  background: linear-gradient(150deg, rgba(24, 28, 45, .9), rgba(17, 20, 32, .72));
  transition: transform .22s, border-color .22s, box-shadow .22s;
}
.project-card:hover {
  transform: translateY(-3px);
  border-color: rgba(124, 108, 255, .55);
  box-shadow: 0 12px 30px rgba(5, 7, 20, .36);
}
.project-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}
.project-card h3 { margin: 0; font-size: 1.14rem; }
.project-card h3 a { color: inherit; text-decoration: none; }
.project-card h3 a:hover { color: #b6b0ff; }
.project-card > p { margin: 0 0 12px; color: var(--vp-c-text-2); font-size: .9rem; line-height: 1.75; }
.project-card-links { display: flex; flex-wrap: wrap; gap: 8px; }
.project-card-links a {
  padding: 4px 11px;
  border-radius: 8px;
  border: 1px solid rgba(124, 108, 255, .34);
  background: rgba(124, 108, 255, .08);
  color: #b9b2ff;
  font-size: .78rem;
  text-decoration: none;
  transition: background .2s, border-color .2s;
}
.project-card-links a:hover { background: rgba(124, 108, 255, .18); border-color: rgba(124, 108, 255, .6); }
:root:not(.dark) .project-card {
  background: linear-gradient(150deg, rgba(255, 255, 255, .98), rgba(241, 243, 250, .94));
  box-shadow: 0 8px 22px rgba(43, 50, 91, .05);
}
:root:not(.dark) .project-card:hover { box-shadow: 0 14px 32px rgba(43, 50, 91, .11); }
:root:not(.dark) .project-card h3 a:hover,
:root:not(.dark) .project-card-links a { color: #5c4fe0; }
:root:not(.dark) .project-card-links a { background: rgba(92, 79, 224, .06); border-color: rgba(92, 79, 224, .22); }

/* ---- 图片框 ---- */
.img-frame {
  margin: 18px 0 24px;
  border: 1px solid var(--vp-c-divider);
  border-radius: 14px;
  overflow: hidden;
  background: rgba(10, 13, 22, .6);
  box-shadow: 0 14px 34px rgba(5, 7, 20, .32);
}
.img-frame img {
  display: block;
  width: 100%;
  height: auto;
  margin: 0;
  border-radius: 0;
  transition: transform .35s ease;
}
.img-frame:hover img { transform: scale(1.015); }
.img-frame figcaption,
.img-cap {
  padding: 10px 14px;
  border-top: 1px solid var(--vp-c-divider);
  color: var(--vp-c-text-2);
  font-size: .8rem;
  text-align: center;
  background: rgba(14, 17, 27, .72);
}
:root:not(.dark) .img-frame { background: #fff; box-shadow: 0 10px 26px rgba(43, 50, 91, .08); }
:root:not(.dark) .img-frame figcaption,
:root:not(.dark) .img-cap { background: rgba(247, 248, 252, .9); }

/* ---- 步骤列表 ---- */
ol.steps { list-style: none; counter-reset: step; margin: 16px 0 22px; padding: 0; }
ol.steps li {
  position: relative;
  counter-increment: step;
  margin: 0 0 10px;
  padding: 13px 16px 13px 52px;
  border: 1px solid var(--vp-c-divider);
  border-radius: 12px;
  background: rgba(20, 24, 39, .6);
  line-height: 1.7;
}
ol.steps li::before {
  content: counter(step, decimal-leading-zero);
  position: absolute;
  left: 13px;
  top: 50%;
  transform: translateY(-50%);
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: 9px;
  background: linear-gradient(135deg, #7c6cff, #5cc8ff);
  color: #fff;
  font-family: var(--vp-font-family-mono);
  font-size: .74rem;
  font-weight: 700;
}
:root:not(.dark) ol.steps li { background: rgba(255, 255, 255, .72); }

/* ---- 信息网格 ---- */
.info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 12px;
  margin: 14px 0 22px;
}
.info-grid .cell {
  padding: 14px 16px;
  border: 1px solid var(--vp-c-divider);
  border-radius: 12px;
  background: rgba(20, 24, 39, .6);
}
.info-grid .cell b {
  display: block;
  margin-bottom: 4px;
  font-size: .72rem;
  color: #9189ff;
  font-family: var(--vp-font-family-mono);
  letter-spacing: .08em;
}
.info-grid .cell span { font-size: .9rem; color: var(--vp-c-text-1); }
:root:not(.dark) .info-grid .cell { background: rgba(255, 255, 255, .72); }

/* ---- 产出清单 ---- */
.output-box {
  margin: 14px 0 22px;
  padding: 16px 18px;
  border: 1px solid rgba(66, 214, 165, .26);
  border-left: 3px solid #42d6a5;
  border-radius: 12px;
  background: rgba(66, 214, 165, .06);
}
.output-box b {
  display: block;
  margin-bottom: 8px;
  color: #42d6a5;
  font-size: .82rem;
  letter-spacing: .06em;
}
.output-box ul { margin: 0; padding-left: 18px; color: var(--vp-c-text-1); line-height: 1.9; }

/* ---- 链接卡片 ---- */
.link-box { display: flex; flex-wrap: wrap; gap: 10px; margin: 12px 0 22px; }
.link-box a {
  flex: 1 1 250px;
  padding: 12px 16px;
  border: 1px solid var(--vp-c-divider);
  border-radius: 12px;
  background: rgba(20, 24, 39, .6);
  color: var(--vp-c-text-1);
  text-decoration: none;
  font-size: .88rem;
  transition: border-color .2s, transform .2s;
}
.link-box a:hover { border-color: rgba(124, 108, 255, .55); transform: translateY(-2px); }
.link-box a span {
  display: block;
  margin-bottom: 3px;
  color: #9189ff;
  font-size: .72rem;
  font-family: var(--vp-font-family-mono);
  letter-spacing: .06em;
}
:root:not(.dark) .link-box a { background: rgba(255, 255, 255, .72); }

/* ---- 提示框 ---- */
.note-box {
  margin: 14px 0 22px;
  padding: 14px 18px;
  border: 1px solid rgba(92, 200, 255, .24);
  border-left: 3px solid #5cc8ff;
  border-radius: 12px;
  background: rgba(92, 200, 255, .06);
  color: var(--vp-c-text-1);
  font-size: .9rem;
  line-height: 1.8;
}
.note-box b { color: #5cc8ff; }

/* ---- 模板折叠框 ---- */
details.template-box {
  margin: 16px 0 28px;
  border: 1px solid var(--vp-c-divider);
  border-radius: 14px;
  background: rgba(20, 24, 39, .6);
  overflow: hidden;
}
details.template-box > summary {
  cursor: pointer;
  padding: 14px 18px;
  font-weight: 700;
  font-size: .95rem;
  color: var(--vp-c-text-1);
  list-style: none;
  user-select: none;
  transition: background .2s;
}
details.template-box > summary::-webkit-details-marker { display: none; }
details.template-box > summary::after {
  content: '+';
  float: right;
  color: #9189ff;
  font-size: 1.15rem;
  line-height: 1;
  transition: transform .2s;
}
details.template-box[open] > summary { background: rgba(124, 108, 255, .1); }
details.template-box[open] > summary::after { transform: rotate(45deg); }
details.template-box > summary:hover { background: rgba(124, 108, 255, .08); }
details.template-box .template-body { padding: 6px 18px 18px; }
:root:not(.dark) details.template-box { background: rgba(255, 255, 255, .72); }

/* ---- 项目页 meta 区 ---- */
.project-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin: 2px 0 24px;
}

/* ---- 分类 chips（学习/论文板块）---- */
.topic-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 20px; }
.topic-chips .tag-chip { margin: 0; }

/* ---- 文档通用排版微调 ---- */
.vp-doc h2 {
  margin-top: 42px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--vp-c-divider);
}
.vp-doc h2::before {
  content: '';
  display: inline-block;
  width: 5px;
  height: 1.05em;
  margin-right: 10px;
  border-radius: 3px;
  background: linear-gradient(180deg, #7c6cff, #5cc8ff);
  vertical-align: -0.14em;
}
.vp-doc blockquote {
  border-left: 3px solid rgba(124, 108, 255, .55);
  background: rgba(124, 108, 255, .06);
  padding: 10px 16px;
  border-radius: 0 10px 10px 0;
}
@media (max-width: 760px) {
  .slam-board { grid-template-columns: 1fr; }
  .slam-hero { padding: 22px 20px; }
  .info-grid { grid-template-columns: 1fr; }
}

/* ---- 数据统计条 ---- */
.stats-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin: 0 0 28px;
}
.stat-cell {
  padding: 18px 14px;
  border: 1px solid var(--vp-c-divider);
  border-radius: 14px;
  background: linear-gradient(150deg, rgba(24, 28, 45, .9), rgba(17, 20, 32, .72));
  text-align: center;
}
.stat-cell b {
  display: block;
  margin-bottom: 4px;
  font-size: 1.7rem;
  line-height: 1.1;
  background: linear-gradient(92deg, #b9b2ff, #7ce4ff);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.stat-cell span { font-size: .78rem; color: var(--vp-c-text-2); }
:root:not(.dark) .stat-cell {
  background: linear-gradient(150deg, rgba(255, 255, 255, .98), rgba(241, 243, 250, .94));
  box-shadow: 0 8px 22px rgba(43, 50, 91, .05);
}
:root:not(.dark) .stat-cell b {
  background: linear-gradient(92deg, #5c4fe0, #0e7f96);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ---- 项目网格（封面卡片） ---- */
.project-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin: 10px 0 32px;
}
.project-tile {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--vp-c-divider);
  border-radius: 16px;
  background: linear-gradient(160deg, rgba(24, 28, 45, .94), rgba(16, 19, 31, .82));
  transition: transform .25s, border-color .25s, box-shadow .25s;
}
.project-tile:hover {
  transform: translateY(-5px);
  border-color: rgba(124, 108, 255, .6);
  box-shadow: 0 18px 44px rgba(5, 7, 20, .45);
}
.project-tile__cover {
  position: relative;
  display: block;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #0b0e16;
}
.project-tile__cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .45s ease;
}
.project-tile:hover .project-tile__cover img { transform: scale(1.06); }
.project-tile__cover::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(11, 14, 22, .58), transparent 58%);
  pointer-events: none;
}
.project-tile__cover .status-pill {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 1;
  background: rgba(11, 14, 22, .72);
  backdrop-filter: blur(6px);
}
.project-tile__cover--placeholder {
  display: grid;
  place-items: center;
  color: rgba(255, 255, 255, .88);
}
.project-tile__cover--placeholder .ph {
  position: relative;
  z-index: 1;
  padding: 0 18px;
  font-family: var(--vp-font-family-mono);
  font-size: 1.12rem;
  letter-spacing: .14em;
  text-align: center;
}
.ph-go2 {
  background:
    radial-gradient(circle at 78% 24%, rgba(92, 200, 255, .5), transparent 42%),
    radial-gradient(circle at 20% 78%, rgba(124, 108, 255, .55), transparent 44%),
    linear-gradient(135deg, #101c33, #1a1330);
}
.ph-carto {
  background:
    radial-gradient(circle at 70% 30%, rgba(66, 214, 165, .42), transparent 44%),
    radial-gradient(circle at 26% 72%, rgba(124, 108, 255, .5), transparent 46%),
    linear-gradient(135deg, #0f1f28, #13182e);
}
.project-tile__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 18px 18px 16px;
}
.project-tile__body h3 {
  margin: 0 0 8px;
  font-size: 1.08rem;
  line-height: 1.45;
}
.project-tile__body h3 a { color: inherit; text-decoration: none; }
.project-tile__body h3 a:hover { color: #b6b0ff; }
.project-tile__body > p {
  flex: 1;
  margin: 0 0 12px;
  color: var(--vp-c-text-2);
  font-size: .86rem;
  line-height: 1.7;
}
.project-tile__tags { margin-bottom: 14px; }
.project-tile__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
}
.tile-more {
  color: #b6b0ff;
  font-size: .84rem;
  font-weight: 650;
  text-decoration: none;
}
.tile-more b { padding-left: 4px; transition: padding .2s; }
.project-tile:hover .tile-more b { padding-left: 9px; }
.tile-links { display: flex; gap: 6px; flex-wrap: wrap; }
.tile-links a {
  padding: 4px 10px;
  border-radius: 8px;
  border: 1px solid rgba(124, 108, 255, .34);
  background: rgba(124, 108, 255, .08);
  color: #b9b2ff;
  font-size: .74rem;
  text-decoration: none;
  transition: background .2s;
}
.tile-links a:hover { background: rgba(124, 108, 255, .18); }
:root:not(.dark) .project-tile {
  background: linear-gradient(160deg, rgba(255, 255, 255, .99), rgba(241, 243, 250, .94));
  box-shadow: 0 8px 22px rgba(43, 50, 91, .05);
}
:root:not(.dark) .project-tile:hover { box-shadow: 0 16px 36px rgba(43, 50, 91, .13); }
:root:not(.dark) .project-tile__body h3 a:hover,
:root:not(.dark) .tile-more,
:root:not(.dark) .tile-links a { color: #5c4fe0; }
:root:not(.dark) .tile-links a { background: rgba(92, 79, 224, .06); border-color: rgba(92, 79, 224, .22); }
@media (max-width: 900px) { .project-grid { grid-template-columns: 1fr; } }
@media (max-width: 640px) { .stats-strip { grid-template-columns: repeat(2, 1fr); } }

/* =========================================================
   首页 · 站点风格 + 鼠标交互 + 文字跳动
   ========================================================= */
.VPHome { padding: 0 !important; }
/* 首页固定高度，禁止滚动 */
.home-cover {
  position: relative;
  height: calc(100vh - var(--vp-nav-height, 64px));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 64px 24px 48px;
  overflow: hidden;
}
/* 鼠标跟随光斑 */
.home-cover__spotlight {
  position: absolute;
  top: 0;
  left: 0;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 108, 255, .15), rgba(124, 108, 255, .05) 42%, transparent 68%);
  pointer-events: none;
  opacity: 0;
  transition: opacity .3s;
  will-change: transform;
}
/* 头像后方静态光晕 */
.home-cover__glow {
  position: absolute;
  top: 8%;
  left: 50%;
  transform: translateX(-50%);
  width: min(520px, 90vw);
  height: 320px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 108, 255, .15), transparent 66%);
  pointer-events: none;
}
/* 头像：固定不动 */
.home-cover__avatar {
  position: relative;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  object-fit: cover;
  object-position: 50% 35%;
  border: 4px solid var(--vp-c-bg);
  box-shadow: 0 0 0 2px rgba(124, 108, 255, .5), 0 0 0 10px rgba(124, 108, 255, .09), 0 24px 48px rgba(5, 7, 20, .35);
  opacity: 0;
  animation: home-fade-up .7s cubic-bezier(.22, .8, .24, 1) .05s forwards;
}
.home-cover__glow { top: 50%; height: 420px; transform: translate(-50%, -58%); }
.home-cover__name {
  position: relative;
  margin: 26px 0 0;
  font-size: clamp(2.6rem, 5.5vw, 4rem);
  font-weight: 800;
  letter-spacing: -.03em;
  line-height: 1.1;
  background: linear-gradient(92deg, #f2f1ff 10%, #b9b2ff 48%, #7ce4ff 92%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  opacity: 0;
  animation: home-fade-up .7s cubic-bezier(.22, .8, .24, 1) .18s forwards;
}
/* 标语：逐字左右波动 */
.home-cover__role {
  position: relative;
  margin: 16px 0 0;
  font-size: clamp(1rem, 2vw, 1.25rem);
  color: var(--vp-c-text-2);
  line-height: 1.7;
  opacity: 0;
  animation: home-fade-up .7s cubic-bezier(.22, .8, .24, 1) .32s forwards;
}
.home-cover__role {
  position: relative;
  min-height: 1.7em;
  margin: 16px 0 0;
  font-size: clamp(1rem, 2vw, 1.25rem);
  color: var(--vp-c-text-2);
  line-height: 1.7;
  opacity: 0;
  animation: home-fade-up .7s cubic-bezier(.22, .8, .24, 1) .32s forwards;
}
/* 底部栏 */
.home-cover__foot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 22px;
  text-align: center;
  font-size: .74rem;
  letter-spacing: .08em;
  color: var(--vp-c-text-2);
  opacity: .75;
}
.home-cover__links {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 42px;
  padding-top: 26px;
  border-top: 1px solid var(--vp-c-divider);
  opacity: 0;
  animation: home-fade-up .7s cubic-bezier(.22, .8, .24, 1) .46s forwards;
}
.home-cover__links a {
  position: relative;
  padding: 0 22px;
  color: var(--vp-c-text-2);
  font-size: .9rem;
  font-weight: 600;
  letter-spacing: .06em;
  text-decoration: none;
  transition: color .2s;
}
.home-cover__links a + a { border-left: 1px solid var(--vp-c-divider); }
.home-cover__links a:hover { color: var(--vp-c-brand-1); }
.home-cover__links a::after {
  content: '';
  position: absolute;
  left: 22px;
  right: 22px;
  bottom: -7px;
  height: 2px;
  border-radius: 2px;
  background: var(--vp-c-brand-1);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .25s;
}
.home-cover__links a:hover::after { transform: scaleX(1); }
@keyframes home-fade-up {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: translateY(0); }
}
:root:not(.dark) .home-cover__name {
  background: linear-gradient(92deg, #23204d 10%, #5c4fe0 55%, #0e7f96 95%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
:root:not(.dark) .home-cover__avatar {
  box-shadow: 0 0 0 2px rgba(92, 79, 224, .4), 0 0 0 10px rgba(92, 79, 224, .07), 0 24px 48px rgba(43, 50, 91, .18);
}
:root:not(.dark) .home-cover__glow {
  background: radial-gradient(circle, rgba(124, 108, 255, .12), transparent 66%);
}
:root:not(.dark) .home-cover__spotlight {
  background: radial-gradient(circle, rgba(124, 108, 255, .12), rgba(124, 108, 255, .04) 42%, transparent 68%);
}
@media (max-width: 640px) {
  .home-cover__glow { top: 50%; height: 320px; }
  .home-cover { padding: 40px 20px 32px; }
  .home-cover__avatar { width: 104px; height: 104px; }
  .home-cover__name { margin-top: 18px; }
  .home-cover__links { margin-top: 30px; padding-top: 20px; }
  .home-cover__links a { padding: 0 13px; font-size: .84rem; }
  .home-cover__links a::after { left: 13px; right: 13px; }
}
@media (prefers-reduced-motion: reduce) {
  .home-cover__spotlight { display: none; }
  .home-cover__avatar, .home-cover__name, .home-cover__role, .home-cover__links {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
}

/* =========================================================
   视觉收束：更克制的编辑型知识库界面
   ========================================================= */
:root {
  --vp-c-brand-1: #63d7c3;
  --vp-c-brand-2: #8be7d7;
  --vp-c-brand-3: #35b9a5;
  --vp-c-bg: #0b1015;
  --vp-c-bg-soft: #111a20;
  --vp-c-bg-alt: #080c10;
  --vp-c-text-1: #edf5f2;
  --vp-c-text-2: #9caeaa;
  --vp-c-divider: rgba(164, 194, 187, .15);
}
:root:not(.dark) {
  --vp-c-brand-1: #168c79;
  --vp-c-brand-2: #2da995;
  --vp-c-brand-3: #0e705f;
  --vp-c-bg: #f5f7f5;
  --vp-c-bg-soft: #ffffff;
  --vp-c-bg-alt: #e9efed;
  --vp-c-text-1: #182522;
  --vp-c-text-2: #667572;
  --vp-c-divider: rgba(45, 78, 69, .14);
}
html { background: var(--vp-c-bg); }
body { background: radial-gradient(900px 420px at 76% -10%, rgba(50, 180, 159, .12), transparent 70%), var(--vp-c-bg); }
:root:not(.dark) body { background: radial-gradient(900px 420px at 76% -10%, rgba(45, 169, 149, .11), transparent 70%), var(--vp-c-bg); }
::selection { color: #06120f; background: rgba(99, 215, 195, .8); }
.VPNav { background: rgba(11, 16, 21, .78) !important; border-bottom: 1px solid var(--vp-c-divider) !important; }
:root:not(.dark) .VPNav { background: rgba(245, 247, 245, .84) !important; }
.VPNavBarTitle .title { letter-spacing: .12em; font-size: .88rem; }
.VPNavBarMenuLink { font-size: .82rem; letter-spacing: .02em; }
.VPNavBarMenuLink:hover, .VPNavBarMenuLink.active { color: var(--vp-c-brand-1) !important; }
.home-cover { background: linear-gradient(180deg, rgba(11, 16, 21, .1), rgba(11, 16, 21, .35)); }
.home-cover::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .3; background-image: linear-gradient(rgba(99,215,195,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(99,215,195,.07) 1px, transparent 1px); background-size: 72px 72px; mask-image: linear-gradient(to bottom, #000, transparent 72%); }
:root:not(.dark) .home-cover { background: linear-gradient(180deg, rgba(255,255,255,.1), rgba(233,239,237,.45)); }
.home-cover__glow { width: min(640px, 95vw); height: 360px; background: radial-gradient(circle, rgba(51, 185, 165, .15), transparent 68%); }
.home-cover__avatar { border-color: var(--vp-c-bg); box-shadow: 0 0 0 1px rgba(99,215,195,.72), 0 0 0 9px rgba(99,215,195,.08), 0 26px 60px rgba(0,0,0,.38); }
.home-cover__name { background: linear-gradient(100deg, #f0f8f5 10%, #a5e7da 56%, #e4bb83 100%); -webkit-background-clip: text; background-clip: text; }
.home-cover__links a:hover { color: var(--vp-c-brand-1); }
.home-cover__links a::after { background: var(--vp-c-brand-1); }
.topic-card, .slam-card, .project-card, .stat-cell { border-radius: 12px; box-shadow: 0 16px 34px rgba(0,0,0,.12); }
.topic-card:hover, .slam-card:hover, .project-card:hover { border-color: rgba(99,215,195,.6); box-shadow: 0 20px 42px rgba(0,0,0,.22); }
.topic-card--accent { background: linear-gradient(145deg, rgba(23, 71, 68, .7), rgba(18, 27, 32, .78)); }
.status--wip { color: #e8c48e; }
.tag-chip { border-color: rgba(99,215,195,.3); background: rgba(99,215,195,.08); color: #9de5d8; }
.vp-doc h2::before { background: linear-gradient(180deg, #63d7c3, #e4bb83); }
@media (max-width: 640px) { .home-cover::before { background-size: 52px 52px; } }

/* 首页焦点动效：轨道 + 呼吸光晕 + 轻量扫描纹理 */
.home-cover::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(330px, 72vw);
  aspect-ratio: 1;
  border: 1px solid rgba(99, 215, 195, .22);
  border-radius: 50%;
  transform: translate(-50%, -58%) rotate(-18deg);
  box-shadow: 0 0 0 26px rgba(99, 215, 195, .025), 0 0 0 54px rgba(228, 187, 131, .018);
  pointer-events: none;
  animation: home-orbit 14s linear infinite;
}
.home-cover__glow {
  animation: home-glow 5.5s ease-in-out infinite;
}
.home-cover__avatar {
  z-index: 2;
  filter: saturate(.94) contrast(1.04);
  animation: home-fade-up .7s cubic-bezier(.22, .8, .24, 1) .05s forwards, avatar-breathe 5.5s ease-in-out 1s infinite;
}
.home-cover__avatar::after { content: none; }
.home-cover__role::after {
  content: '';
  display: inline-block;
  width: 1px;
  height: 1em;
  margin-left: 4px;
  background: var(--vp-c-brand-1);
  vertical-align: -.12em;
  animation: caret-blink 1s steps(1) infinite;
}
@keyframes home-orbit { to { transform: translate(-50%, -58%) rotate(342deg); } }
@keyframes home-glow { 0%, 100% { opacity: .62; transform: translateX(-50%) scale(.94); } 50% { opacity: 1; transform: translateX(-50%) scale(1.06); } }
@keyframes avatar-breathe { 0%, 100% { box-shadow: 0 0 0 1px rgba(99,215,195,.72), 0 0 0 9px rgba(99,215,195,.08), 0 26px 60px rgba(0,0,0,.38); } 50% { box-shadow: 0 0 0 1px rgba(99,215,195,.95), 0 0 0 13px rgba(99,215,195,.12), 0 28px 70px rgba(0,0,0,.48); } }
@keyframes caret-blink { 50% { opacity: 0; } }
@media (max-width: 640px) { .home-cover::after { width: 250px; transform: translate(-50%, -60%); } }
@media (prefers-reduced-motion: reduce) { .home-cover::after, .home-cover__glow, .home-cover__avatar, .home-cover__role::after { animation: none !important; } }

/* 头像视觉组件：放大主体，并用光圈与定位点补足层次 */
.home-cover__avatar {
  width: 178px;
  height: 178px;
  border-width: 5px;
  box-shadow: 0 0 0 1px rgba(99,215,195,.84), 0 0 0 10px rgba(99,215,195,.1), 0 0 0 22px rgba(228,187,131,.045), 0 28px 72px rgba(0,0,0,.46);
}
.home-cover__glow::before,
.home-cover__glow::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
  pointer-events: none;
  transform: translate(-50%, -50%);
}
.home-cover__glow::before {
  width: 258px;
  height: 258px;
  border: 1px solid rgba(99,215,195,.28);
  border-left-color: transparent;
  border-bottom-color: rgba(228,187,131,.3);
  animation: avatar-ring-spin 18s linear infinite;
}
.home-cover__glow::after {
  width: 214px;
  height: 214px;
  border: 1px dashed rgba(99,215,195,.2);
  animation: avatar-ring-spin 26s linear infinite reverse;
}
@keyframes avatar-ring-spin { to { transform: translate(-50%, -50%) rotate(360deg); } }
@media (max-width: 640px) {
  .home-cover__avatar { width: 142px; height: 142px; }
  .home-cover__glow::before { width: 210px; height: 210px; }
  .home-cover__glow::after { width: 174px; height: 174px; }
}
@media (prefers-reduced-motion: reduce) { .home-cover__glow::before, .home-cover__glow::after { animation: none !important; } }

/* 气泡式主题标签：替代大面积圆环，让首页更轻、更有内容感 */
.home-cover::after,
.home-cover__glow::before,
.home-cover__glow::after { display: none; }
.home-bubbles { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
.home-bubble {
  position: absolute;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 92px;
  min-height: 48px;
  padding: 10px 15px;
  border: 1px solid rgba(99, 215, 195, .34);
  border-radius: 16px 16px 16px 5px;
  background: rgba(17, 29, 31, .72);
  box-shadow: 0 12px 26px rgba(0,0,0,.2), inset 0 1px 0 rgba(255,255,255,.07);
  color: #c8eee7;
  font-family: var(--vp-font-family-mono);
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .06em;
  text-align: left;
  backdrop-filter: blur(10px);
  animation: bubble-float 6s ease-in-out infinite;
}
.home-bubble small { display: block; margin-top: 4px; color: #8fa9a5; font-family: var(--vp-font-family-base); font-size: .66rem; font-weight: 500; letter-spacing: 0; white-space: nowrap; }
.home-bubble--slam { top: calc(50% - 150px); left: calc(50% - 245px); animation-delay: -.8s; }
.home-bubble--linux { top: calc(50% + 74px); left: calc(50% - 238px); border-color: rgba(228,187,131,.35); color: #f0d5a7; animation-delay: -2.2s; }
.home-bubble--vln { top: calc(50% - 128px); left: calc(50% + 145px); border-radius: 16px 16px 5px 16px; border-color: rgba(123,187,255,.34); color: #b8d9ff; animation-delay: -3.6s; }
.home-bubble--notes { top: calc(50% + 104px); left: calc(50% + 122px); border-radius: 16px 16px 5px 16px; animation-delay: -1.5s; }
.home-bubble-dot { position: absolute; width: 7px; height: 7px; border-radius: 50%; background: #63d7c3; box-shadow: 0 0 0 5px rgba(99,215,195,.08), 0 0 15px rgba(99,215,195,.65); animation: bubble-dot 4.5s ease-in-out infinite; }
.home-bubble-dot--one { top: calc(50% - 105px); left: calc(50% - 170px); }
.home-bubble-dot--two { top: calc(50% + 42px); left: calc(50% + 176px); animation-delay: -1.8s; background: #e4bb83; }
.home-bubble-dot--three { top: calc(50% + 146px); left: calc(50% - 165px); animation-delay: -3.1s; }
@keyframes bubble-float { 0%, 100% { transform: translateY(4px) rotate(-1deg); } 50% { transform: translateY(-9px) rotate(1deg); } }
@keyframes bubble-dot { 0%, 100% { transform: translateY(5px); opacity: .45; } 50% { transform: translateY(-12px); opacity: 1; } }
:root:not(.dark) .home-bubble { background: rgba(255,255,255,.78); color: #176f62; box-shadow: 0 12px 28px rgba(38,76,67,.12), inset 0 1px 0 rgba(255,255,255,.9); }
:root:not(.dark) .home-bubble small { color: #6f8580; }
@media (max-width: 700px) {
  .home-bubble { min-width: 70px; min-height: 34px; padding: 7px 10px; font-size: .67rem; border-radius: 12px 12px 12px 4px; }
  .home-bubble small { margin-top: 2px; font-size: .57rem; }
  .home-bubble--slam { top: calc(50% - 122px); left: calc(50% - 155px); }
  .home-bubble--linux { top: calc(50% + 92px); left: calc(50% - 152px); }
  .home-bubble--vln { top: calc(50% - 105px); left: calc(50% + 76px); }
  .home-bubble--notes { top: calc(50% + 112px); left: calc(50% + 68px); }
  .home-bubble-dot--one { top: calc(50% - 76px); left: calc(50% - 112px); }
  .home-bubble-dot--two { top: calc(50% + 63px); left: calc(50% + 112px); }
  .home-bubble-dot--three { top: calc(50% + 128px); left: calc(50% - 104px); }
}
@media (prefers-reduced-motion: reduce) { .home-bubble, .home-bubble-dot { animation: none !important; } }

/* 首页重构：以内容和头像为中心的编辑型首屏 */
.home-bubbles { display: none !important; }
.home-cover {
  gap: 0;
  justify-content: center;
  background: radial-gradient(ellipse 500px 300px at 50% 43%, rgba(46, 130, 119, .12), transparent 72%), linear-gradient(180deg, rgba(11,16,21,.08), rgba(11,16,21,.42));
}
.home-cover::before {
  opacity: .18;
  background-image: linear-gradient(rgba(99,215,195,.055) 1px, transparent 1px), linear-gradient(90deg, rgba(99,215,195,.055) 1px, transparent 1px);
  background-size: 92px 92px;
  mask-image: linear-gradient(to bottom, transparent 0%, #000 24%, #000 62%, transparent 90%);
}
.home-cover__glow { top: 43%; width: min(580px, 92vw); height: 390px; transform: translate(-50%, -50%); background: radial-gradient(ellipse, rgba(48, 151, 137, .16), transparent 66%); animation: home-glow 8s ease-in-out infinite; }
.home-cover__eyebrow { position: relative; z-index: 3; margin: 0 0 20px; color: #86b9b0; font-family: var(--vp-font-family-mono); font-size: .66rem; letter-spacing: .18em; opacity: 0; animation: home-fade-up .7s cubic-bezier(.22,.8,.24,1) .02s forwards; }
.home-cover__eyebrow span { margin: 0 9px; color: #d5ae79; }
.home-cover__portrait { position: relative; z-index: 3; width: 214px; height: 214px; display: grid; place-items: center; }
.home-cover__portrait::before { content: ''; position: absolute; inset: 8px; border: 1px solid rgba(99,215,195,.42); border-radius: 50%; box-shadow: 0 0 0 1px rgba(99,215,195,.07), 0 0 34px rgba(55,177,157,.13); }
.home-cover__portrait::after { content: ''; position: absolute; inset: -5px 22px; border-top: 1px solid rgba(228,187,131,.55); border-bottom: 1px solid rgba(228,187,131,.2); border-radius: 50%; transform: rotate(-22deg); opacity: .75; animation: portrait-scan 9s linear infinite; }
.home-cover__avatar { width: 176px; height: 176px; border: 5px solid var(--vp-c-bg); box-shadow: 0 0 0 1px rgba(99,215,195,.8), 0 22px 58px rgba(0,0,0,.44); animation: home-fade-up .7s cubic-bezier(.22,.8,.24,1) .08s forwards, avatar-breathe 6s ease-in-out 1s infinite; }
.home-cover__portrait-index { position: absolute; top: 8px; left: -4px; color: #d5ae79; font-family: var(--vp-font-family-mono); font-size: .64rem; letter-spacing: .12em; }
.home-cover__portrait-status { position: absolute; right: -38px; bottom: 26px; display: inline-flex; align-items: center; gap: 7px; padding: 6px 9px; border: 1px solid rgba(99,215,195,.2); border-radius: 6px; background: rgba(12,22,24,.68); color: #91bcb5; font-family: var(--vp-font-family-mono); font-size: .6rem; letter-spacing: .05em; }
.home-cover__portrait-status i { width: 5px; height: 5px; border-radius: 50%; background: #63d7c3; box-shadow: 0 0 9px #63d7c3; }
.home-cover__name { z-index: 3; margin-top: 25px; font-size: clamp(2.8rem, 6vw, 4.6rem); letter-spacing: .02em; }
.home-cover__role { z-index: 3; margin-top: 12px; font-size: clamp(1rem, 2vw, 1.2rem); letter-spacing: .04em; }
.home-cover__intro { position: relative; z-index: 3; margin: 8px 0 0; color: #71847f; font-family: var(--vp-font-family-mono); font-size: .7rem; letter-spacing: .12em; opacity: 0; animation: home-fade-up .7s cubic-bezier(.22,.8,.24,1) .4s forwards; }
.home-cover__links { z-index: 3; margin-top: 32px; padding-top: 19px; }
.home-cover__foot { z-index: 3; }
@keyframes portrait-scan { 0% { transform: rotate(-22deg); opacity: .25; } 50% { opacity: .85; } 100% { transform: rotate(338deg); opacity: .25; } }
:root:not(.dark) .home-cover { background: radial-gradient(ellipse 500px 300px at 50% 43%, rgba(45,169,149,.1), transparent 72%), linear-gradient(180deg, rgba(255,255,255,.08), rgba(233,239,237,.45)); }
:root:not(.dark) .home-cover__portrait-status { background: rgba(255,255,255,.74); color: #4c746d; }
:root:not(.dark) .home-cover__intro { color: #78908a; }
@media (max-width: 640px) {
  .home-cover__eyebrow { margin-bottom: 12px; font-size: .56rem; letter-spacing: .12em; }
  .home-cover__portrait { width: 174px; height: 174px; }
  .home-cover__avatar { width: 142px; height: 142px; }
  .home-cover__portrait-status { right: -36px; bottom: 15px; font-size: .54rem; }
  .home-cover__portrait-index { top: 0; left: -8px; }
  .home-cover__name { margin-top: 18px; }
  .home-cover__intro { font-size: .58rem; letter-spacing: .08em; }
  .home-cover__links { margin-top: 25px; }
}
@media (prefers-reduced-motion: reduce) { .home-cover__portrait::after { animation: none; } }

/* =========================================================
   首页新增内容样式 - 优化后的首页扩展区
   ========================================================= */
.home-content {
  max-width: 1200px;
  margin: 0 auto;
  padding: 60px 24px;
  position: relative;
  z-index: 10;
}

/* 滚动提示箭头 */
.home-cover__scroll {
  position: absolute;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%);
  width: max-content;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: var(--vp-c-text-2);
  font-size: .85rem;
  cursor: pointer;
  opacity: 0;
  animation: home-fade-up .7s cubic-bezier(.22,.8,.24,1) .6s forwards;
  transition: color .3s;
  z-index: 3;
}
.home-cover__scroll:hover {
  color: var(--vp-c-brand-1);
}
.home-cover__scroll i {
  width: 20px;
  height: 20px;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(45deg);
  animation: scroll-bounce 2s ease-in-out infinite;
}
@keyframes scroll-bounce {
  0%, 100% { transform: rotate(45deg) translateY(0); }
  50% { transform: rotate(45deg) translateY(8px); }
}

/* 统计数据区 */
.home-stats {
  margin-bottom: 80px;
}
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  max-width: 900px;
  margin: 0 auto;
}
.stat-card {
  text-align: center;
  padding: 32px 24px;
  border: 1px solid var(--vp-c-divider);
  border-radius: 16px;
  background: rgba(20,24,39,.72);
  transition: transform .25s, border-color .25s;
}
.stat-card:hover {
  transform: translateY(-4px);
  border-color: rgba(124,108,255,.66);
}
.stat-number {
  display: block;
  font-size: 2.5rem;
  font-weight: 800;
  background: linear-gradient(135deg, #7c6cff, #5cc8ff);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 8px;
}
.stat-label {
  color: var(--vp-c-text-2);
  font-size: .95rem;
  font-family: var(--vp-font-family-mono);
}

/* 通用区块标题 */
.section-header {
  text-align: center;
  margin-bottom: 48px;
}
.section-eyebrow {
  color: #9189ff;
  font-family: var(--vp-font-family-mono);
  font-size: .68rem;
  letter-spacing: .13em;
  margin: 0 0 12px;
}
.section-header h2 {
  font-size: 2rem;
  margin: 0;
  background: linear-gradient(90deg, var(--vp-c-text-1), var(--vp-c-text-2));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 精选项目区 */
.home-featured {
  margin-bottom: 100px;
}
.featured-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.featured-card {
  display: flex;
  flex-direction: column;
  min-height: 280px;
  padding: 28px;
  border: 1px solid var(--vp-c-divider);
  border-radius: 17px;
  color: inherit;
  text-decoration: none;
  background: rgba(20,24,39,.72);
  transition: transform .25s, border-color .25s, background .25s;
  position: relative;
  overflow: hidden;
}
.featured-card--highlight {
  background: linear-gradient(150deg, rgba(75,65,174,.42), rgba(20,24,39,.76) 65%);
  border-color: rgba(124,108,255,.4);
}
.featured-card:hover {
  transform: translateY(-5px);
  border-color: rgba(124,108,255,.66);
  background: rgba(29,32,55,.9);
}
.card-badge {
  display: inline-block;
  width: fit-content;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: .7rem;
  font-family: var(--vp-font-family-mono);
  background: rgba(66,214,165,.15);
  color: #42d6a5;
  margin-bottom: 16px;
}
.featured-card h3 {
  font-size: 1.25rem;
  margin: 0 0 12px;
  color: var(--vp-c-text-1);
}
.featured-card p {
  flex: 1;
  color: var(--vp-c-text-2);
  font-size: .9rem;
  line-height: 1.7;
  margin: 0 0 20px;
}
.card-link {
  color: #b6b0ff;
  font-size: .85rem;
  font-weight: 650;
  transition: padding .2s;
}
.featured-card:hover .card-link {
  padding-left: 6px;
}

/* 知识板块区 */
.home-categories {
  margin-bottom: 100px;
}
.categories-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.category-card {
  display: flex;
  flex-direction: column;
  padding: 28px 24px;
  border: 1px solid var(--vp-c-divider);
  border-radius: 16px;
  color: inherit;
  text-decoration: none;
  background: rgba(20,24,39,.72);
  transition: transform .25s, border-color .25s;
}
.category-card:hover {
  transform: translateY(-4px);
  border-color: rgba(124,108,255,.6);
}
.category-icon {
  font-size: 2.5rem;
  margin-bottom: 16px;
}
.category-card h3 {
  font-size: 1.15rem;
  margin: 0 0 10px;
  color: var(--vp-c-text-1);
}
.category-card p {
  color: var(--vp-c-text-2);
  font-size: .85rem;
  line-height: 1.6;
  margin: 0;
}

/* 最近更新区 */
.home-recent {
  margin-bottom: 60px;
}
.recent-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 800px;
  margin: 0 auto;
}
.recent-item {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 20px 24px;
  border: 1px solid var(--vp-c-divider);
  border-radius: 12px;
  color: inherit;
  text-decoration: none;
  background: rgba(20,24,39,.72);
  transition: transform .25s, border-color .25s;
}
.recent-item:hover {
  transform: translateX(8px);
  border-color: rgba(124,108,255,.55);
}
.recent-date {
  min-width: 80px;
  color: #9189ff;
  font-family: var(--vp-font-family-mono);
  font-size: .85rem;
}
.recent-title {
  flex: 1;
  color: var(--vp-c-text-1);
  font-weight: 500;
}
.recent-tag {
  padding: 4px 12px;
  border-radius: 999px;
  font-size: .75rem;
  background: rgba(124,108,255,.15);
  color: #b5afff;
  font-family: var(--vp-font-family-mono);
}

/* 亮色模式适配 */
:root:not(.dark) .stat-card,
:root:not(.dark) .featured-card,
:root:not(.dark) .category-card,
:root:not(.dark) .recent-item {
  background: rgba(255,255,255,.78);
  box-shadow: 0 12px 30px rgba(43,50,91,.06);
}
:root:not(.dark) .featured-card--highlight {
  background: linear-gradient(150deg, rgba(224,221,255,.86), rgba(255,255,255,.9) 68%);
}

/* 响应式适配 */
@media (max-width: 960px) {
  .stats-grid,
  .featured-grid,
  .categories-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .recent-item {
    flex-wrap: wrap;
    gap: 12px;
  }
  .recent-date {
    min-width: auto;
  }
}
@media (max-width: 640px) {
  .home-content {
    padding: 40px 20px;
  }
  .stats-grid,
  .featured-grid,
  .categories-grid {
    grid-template-columns: 1fr;
  }
  .section-header h2 {
    font-size: 1.5rem;
  }
  .home-cover__scroll span {
    display: none;
  }
  .recent-item {
    flex-direction: column;
    align-items: flex-start;
  }
}
/* 亮色主题下首页所有组件的配色适配 */
:root:not(.dark) .home-cover__name {
  background: linear-gradient(92deg, #23204d 10%, #5c4fe0 55%, #0e7f96 95%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
:root:not(.dark) .home-cover__glow {
  background: radial-gradient(circle, rgba(92,79,224,.12), transparent 66%);
}
:root:not(.dark) .stat-card {
  background: rgba(255,255,255,.85);
  box-shadow: 0 8px 30px rgba(43,50,91,.06);
}
:root:not(.dark) .stat-card:hover {
  border-color: rgba(92,79,224,.55);
}
:root:not(.dark) .stat-number {
  background: linear-gradient(135deg, #5c4fe0, #0a84c8);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
:root:not(.dark) .featured-card,
:root:not(.dark) .category-card,
:root:not(.dark) .recent-item {
  background: rgba(255,255,255,.8);
  box-shadow: 0 8px 25px rgba(43,50,91,.05);
}
:root:not(.dark) .featured-card:hover,
:root:not(.dark) .category-card:hover,
:root:not(.dark) .recent-item:hover {
  background: rgba(255,255,255,.95);
  border-color: rgba(92,79,224,.5);
}
:root:not(.dark) .featured-card p,
:root:not(.dark) .category-card p,
:root:not(.dark) .recent-item p {
  color: var(--vp-c-text-2);
}
:root:not(.dark) .home-cover__scroll {
  color: var(--vp-c-text-2);
}
:root:not(.dark) .home-cover__scroll:hover {
  color: var(--vp-c-brand-1);
}

@media (prefers-reduced-motion: reduce) {
  .home-cover__scroll i {
    animation: none;
  }
}

/* =========================================================
   受保护外链（Gitee / 视频）+ 卡片底部
   ========================================================= */
.slam-card__foot {
  margin-top: auto;
  padding-top: 14px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
}
.protected-links { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.protected-links__item {
  padding: 4px 11px;
  border-radius: 8px;
  border: 1px solid rgba(124, 108, 255, .34);
  background: rgba(124, 108, 255, .08);
  color: #b9b2ff;
  font-size: .78rem;
  text-decoration: none;
  transition: background .2s, border-color .2s;
}
.protected-links__item:hover { background: rgba(124, 108, 255, .18); border-color: rgba(124, 108, 255, .6); }
.protected-links__lock {
  padding: 4px 11px;
  border-radius: 8px;
  border: 1px dashed var(--vp-c-divider);
  background: transparent;
  color: var(--vp-c-text-2);
  font-size: .76rem;
  cursor: pointer;
  transition: border-color .2s, color .2s;
}
.protected-links__lock:hover { border-color: rgba(124, 108, 255, .5); color: var(--vp-c-brand-1); }
.protected-links__form { display: inline-flex; gap: 6px; align-items: center; }
.protected-links__form input {
  width: 118px;
  padding: 4px 8px;
  border-radius: 7px;
  border: 1px solid var(--vp-c-divider);
  background: var(--vp-c-bg);
  color: var(--vp-c-text-1);
  font-size: .78rem;
  outline: none;
  transition: border-color .2s;
}
.protected-links__form input:focus { border-color: var(--vp-c-brand-1); }
.protected-links__form button {
  padding: 4px 10px;
  border: none;
  border-radius: 7px;
  background: var(--vp-c-brand-1);
  color: #fff;
  font-size: .76rem;
  cursor: pointer;
  transition: background .2s;
}
.protected-links__form button:hover { background: var(--vp-c-brand-2); }
.protected-links__error { color: #d64545; font-size: .74rem; }
:root:not(.dark) .protected-links__item {
  color: #5c4fe0;
  background: rgba(92, 79, 224, .06);
  border-color: rgba(92, 79, 224, .22);
}

/* =========================================================
   全站鼠标跟随光斑（覆盖整个页面背景）
   ========================================================= */
.site-spotlight {
  position: fixed;
  top: 0;
  left: 0;
  width: 360px;
  height: 360px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 108, 255, .1), rgba(124, 108, 255, .04) 42%, transparent 68%);
  pointer-events: none;
  z-index: 1;
  opacity: 0;
  transition: opacity .3s;
  will-change: transform;
}
:root:not(.dark) .site-spotlight {
  background: radial-gradient(circle, rgba(124, 108, 255, .08), rgba(124, 108, 255, .03) 42%, transparent 68%);
}
@media (prefers-reduced-motion: reduce) {
  .site-spotlight { display: none; }
}

/* =========================================================
   论文列表：简洁精致的编辑式行
   ========================================================= */
.paper-list { border-top: 1px solid var(--vp-c-divider); margin: 18px 0 40px; }
.paper-row {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 15px 10px;
  border-bottom: 1px solid var(--vp-c-divider);
  color: inherit;
  text-decoration: none;
  transition: background .2s, padding .2s;
}
.paper-row:hover {
  background: var(--vp-c-bg-soft);
  padding-left: 16px;
}
.paper-row__year {
  width: 52px;
  flex-shrink: 0;
  font-family: var(--vp-font-family-mono);
  font-size: .82rem;
  color: var(--vp-c-text-2);
  letter-spacing: .04em;
}
.paper-row__name {
  flex: 1;
  font-size: 1rem;
  font-weight: 600;
  transition: color .2s;
}
.paper-row:hover .paper-row__name { color: var(--vp-c-brand-1); }
.paper-row .status-pill { flex-shrink: 0; }
.paper-row__arrow {
  flex-shrink: 0;
  color: var(--vp-c-text-2);
  opacity: 0;
  transform: translateX(-4px);
  transition: opacity .2s, transform .2s;
}
.paper-row:hover .paper-row__arrow {
  opacity: 1;
  transform: translateX(0);
}
@media (max-width: 520px) {
  .paper-row { gap: 12px; }
  .paper-row__year { width: 40px; }
}

/* =========================================================
   首页最终优化：居中修复 + 统一视觉系统
   ========================================================= */
.home-cover {
  min-height: calc(100svh - var(--vp-nav-height, 64px));
  height: auto;
  box-sizing: border-box;
}

/* 不再依赖 translateX 居中，避免入场动画覆盖 transform 后产生偏移。 */
.home-cover__scroll {
  left: 24px;
  right: 24px;
  bottom: 68px;
  width: auto;
  margin: 0;
  padding: 8px 0;
  border: 0;
  outline: 0;
  background: transparent;
  font-family: inherit;
  text-align: center;
  transform: none;
}
.home-cover__scroll span {
  letter-spacing: .12em;
}
.home-cover__scroll:focus-visible {
  color: var(--vp-c-brand-1);
}
.home-cover__scroll:focus-visible span {
  border-radius: 4px;
  outline: 2px solid var(--vp-c-brand-1);
  outline-offset: 5px;
}

.home-content {
  max-width: 1180px;
  padding-top: 72px;
  padding-bottom: 96px;
}
.home-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 24px;
  right: 24px;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(99, 215, 195, .42), transparent);
}
.home-stats { margin-bottom: 104px; }
.stats-grid { gap: 14px; max-width: 980px; }
.stat-card {
  position: relative;
  overflow: hidden;
  padding: 28px 20px;
  border-radius: 12px;
  background: linear-gradient(145deg, rgba(17, 29, 31, .9), rgba(13, 21, 25, .72));
  box-shadow: 0 14px 32px rgba(0, 0, 0, .16);
}
.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 22%;
  right: 22%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(99, 215, 195, .7), transparent);
}
.stat-card:hover {
  border-color: rgba(99, 215, 195, .52);
  box-shadow: 0 18px 38px rgba(0, 0, 0, .24);
}
.stat-number {
  margin-bottom: 5px;
  background: linear-gradient(135deg, #b8eee4, #63d7c3 58%, #e4bb83);
  -webkit-background-clip: text;
  background-clip: text;
}
.stat-label { font-size: .78rem; letter-spacing: .06em; }

.section-header { margin-bottom: 38px; }
.section-eyebrow {
  color: #75bbae;
  letter-spacing: .17em;
}
.section-header h2 {
  font-size: clamp(1.65rem, 3vw, 2.15rem);
  letter-spacing: -.03em;
  background: linear-gradient(90deg, var(--vp-c-text-1), #9bc9c0);
  -webkit-background-clip: text;
  background-clip: text;
}
.home-featured,
.home-categories { margin-bottom: 112px; }
.featured-grid { gap: 18px; }
.featured-card {
  min-height: 270px;
  padding: 26px;
  border-radius: 13px;
  background: linear-gradient(150deg, rgba(18, 29, 33, .9), rgba(12, 19, 23, .76));
  box-shadow: 0 16px 36px rgba(0, 0, 0, .14);
}
.featured-card::after {
  content: '↗';
  position: absolute;
  top: 22px;
  right: 24px;
  color: var(--vp-c-text-2);
  font-size: 1rem;
  opacity: .42;
  transition: transform .25s, color .25s, opacity .25s;
}
.featured-card--highlight {
  border-color: rgba(99, 215, 195, .38);
  background: linear-gradient(145deg, rgba(24, 72, 68, .72), rgba(14, 24, 28, .84) 72%);
}
.featured-card:hover {
  border-color: rgba(99, 215, 195, .58);
  background: linear-gradient(150deg, rgba(22, 39, 41, .96), rgba(13, 22, 26, .88));
  box-shadow: 0 22px 48px rgba(0, 0, 0, .24);
}
.featured-card:hover::after { color: var(--vp-c-brand-1); opacity: 1; transform: translate(3px, -3px); }
.card-badge {
  border: 1px solid rgba(99, 215, 195, .22);
  background: rgba(99, 215, 195, .09);
  color: #84dfcf;
}
.card-link { color: #8ed9cc; }

.categories-grid { gap: 16px; }
.category-card {
  position: relative;
  min-height: 245px;
  padding: 25px 22px;
  border-radius: 12px;
  background: rgba(15, 25, 29, .76);
  box-shadow: 0 14px 32px rgba(0, 0, 0, .12);
}
.category-card:hover {
  border-color: rgba(99, 215, 195, .52);
  background: rgba(20, 34, 37, .92);
  box-shadow: 0 20px 40px rgba(0, 0, 0, .2);
}
.category-icon {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  margin-bottom: 20px;
  border: 1px solid rgba(99, 215, 195, .22);
  border-radius: 10px;
  background: rgba(99, 215, 195, .07);
  font-size: 1.45rem;
  filter: saturate(.8);
}
.category-card h3 { font-size: 1.08rem; letter-spacing: .02em; }
.category-card p { line-height: 1.72; }

.recent-list { gap: 0; max-width: 860px; border-top: 1px solid var(--vp-c-divider); }
.recent-item {
  gap: 28px;
  padding: 19px 12px;
  border: 0;
  border-bottom: 1px solid var(--vp-c-divider);
  border-radius: 0;
  background: transparent;
}
.recent-item:hover {
  transform: none;
  padding-left: 20px;
  padding-right: 20px;
  border-color: var(--vp-c-divider);
  background: rgba(99, 215, 195, .045);
}
.recent-date { color: #75bbae; }
.recent-tag { background: rgba(99, 215, 195, .09); color: #8bdacd; }

:root:not(.dark) .stat-card,
:root:not(.dark) .featured-card,
:root:not(.dark) .category-card {
  background: rgba(255, 255, 255, .78);
  border-color: rgba(45, 78, 69, .13);
  box-shadow: 0 14px 34px rgba(38, 76, 67, .07);
}
:root:not(.dark) .featured-card--highlight {
  background: linear-gradient(145deg, rgba(216, 242, 236, .9), rgba(255, 255, 255, .9) 72%);
  border-color: rgba(22, 140, 121, .28);
}
:root:not(.dark) .stat-card:hover,
:root:not(.dark) .featured-card:hover,
:root:not(.dark) .category-card:hover {
  background: rgba(255, 255, 255, .98);
  border-color: rgba(22, 140, 121, .42);
  box-shadow: 0 18px 38px rgba(38, 76, 67, .12);
}
:root:not(.dark) .stat-number {
  background: linear-gradient(135deg, #0e705f, #2da995 60%, #a36c28);
  -webkit-background-clip: text;
  background-clip: text;
}
:root:not(.dark) .section-eyebrow,
:root:not(.dark) .recent-date { color: #168c79; }
:root:not(.dark) .card-link,
:root:not(.dark) .recent-tag { color: #0e705f; }
:root:not(.dark) .category-icon { background: rgba(22, 140, 121, .06); border-color: rgba(22, 140, 121, .17); }
:root:not(.dark) .recent-item { background: transparent; box-shadow: none; }
:root:not(.dark) .recent-item:hover { background: rgba(22, 140, 121, .045); }

@media (max-height: 800px) and (min-width: 641px) {
  .home-cover { padding-top: 30px; padding-bottom: 34px; }
  .home-cover__eyebrow { margin-bottom: 10px; }
  .home-cover__portrait { width: 170px; height: 170px; }
  .home-cover__avatar { width: 140px; height: 140px; }
  .home-cover__name { margin-top: 14px; font-size: 2.8rem; }
  .home-cover__role { margin-top: 7px; }
  .home-cover__links { margin-top: 16px; padding-top: 14px; }
  .home-cover__scroll { bottom: 54px; }
  .home-cover__foot { bottom: 15px; }
}
@media (max-width: 640px) {
  .home-cover { min-height: calc(100svh - var(--vp-nav-height, 64px)); padding-bottom: 44px; }
  .home-cover__scroll { left: 16px; right: 16px; bottom: 48px; }
  .home-cover__scroll span { display: inline; font-size: .72rem; }
  .home-cover__scroll i { width: 16px; height: 16px; }
  .home-cover__foot { bottom: 14px; font-size: .62rem; }
  .home-content { padding: 54px 18px 72px; }
  .home-content::before { left: 18px; right: 18px; }
  .home-stats, .home-featured, .home-categories { margin-bottom: 76px; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .stat-card { padding: 22px 10px; }
  .stat-number { font-size: 2rem; }
  .featured-card, .category-card { min-height: 0; }
  .section-header { margin-bottom: 28px; }
  .recent-item { flex-direction: row; align-items: center; gap: 12px; padding: 17px 4px; }
  .recent-title { font-size: .9rem; }
  .recent-tag { margin-left: auto; }
}
@media (prefers-reduced-motion: reduce) {
  .home-cover__scroll { animation: none !important; opacity: 1; }
  .stat-card, .featured-card, .category-card, .recent-item { transition: none; }
}